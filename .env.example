# CELXOR ENVIRONMENT CONFIGURATION

# 1. Solana RPC (Required for market data & transaction broadcast)
SOLANA_RPC_URL="https://mainnet.helius-rpc.com/?api-key=YOUR_API_KEY"

# 2. Database (Required for user configuration storage)
DATABASE_URL="postgresql://postgres:PASSWORD@YOUR_SUPABASE_HOST:6543/postgres"

# 3. Backend Agent Execution Keys (Base58 encoded private keys)
CELXOR_KEY_PAYER=""
CELXOR_KEY_DELEGATE=""
CELXOR_KEY_VENUE_VAULT=""
CELXOR_KEY_DEV_OWNER=""

# Frontend Keys
NEXT_PUBLIC_SOLANA_RPC_URL="https://mainnet.helius-rpc.com/?api-key=YOUR_API_KEY"
